# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@finaldraftstudios.com

# Email alerts via Resend (optional)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Final Draft Admin <alerts@yourdomain.com>
NOTIFY_TO_EMAIL=

# Shared secret the public website sends to /api/notify (use a long random string)
NOTIFY_SECRET=
